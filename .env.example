# ============================================
# TATUA GATEWAY - Environment Configuration
# ============================================

# Server
PORT=3000
NODE_ENV=development

# Your Daraja Credentials (from developer.safaricom.co.ke)
DARAJA_CONSUMER_KEY=your_consumer_key_here
DARAJA_CONSUMER_SECRET=your_consumer_secret_here
DARAJA_ENVIRONMENT=sandbox

# Your public server URL (where Safaricom sends callbacks)
# In development use ngrok: https://abc123.ngrok.io
# In production use your real domain: https://gateway.tatua.co.ke
GATEWAY_BASE_URL=https://your-public-url.com

# Admin secret for internal management endpoints
ADMIN_SECRET=change_this_to_a_strong_random_string

# Transaction Status API (required only for /admin/check-transaction)
# Initiator name from Safaricom Daraja portal (your API operator username)
DARAJA_INITIATOR_NAME=your_initiator_name_here
# Initiator password encrypted with Safaricom's public cert (generate from Daraja portal)
DARAJA_SECURITY_CREDENTIAL=your_encrypted_security_credential_here

# Webhook HMAC signing secret (recommended)
# Businesses verify X-Tatua-Signature on incoming webhooks using this secret
WEBHOOK_SIGNING_SECRET=change_this_to_a_strong_random_string
